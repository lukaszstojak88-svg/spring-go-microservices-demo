# Local development defaults. Copy to `.env` and adjust if needed:
#   cp .env.example .env
# These are NON-SECRET development values. Never commit real credentials.
# Every variable also has the same default in docker-compose.yml.

# --- MongoDB (single instance, authentication enabled) ---
# Root user: administration and the init script only; not used by services.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=root-dev-password

# Product Service database and its dedicated user (readWrite on products_db only)
PRODUCT_DB_NAME=products_db
PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=product-dev-password

# Order Service database and its dedicated user (readWrite on orders_db only)
ORDER_DB_NAME=orders_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order-dev-password

# --- Ports published on the host ---
# BFF is always published.
BFF_PORT=8080
# Published only with `docker compose --profile debug up` (bound to 127.0.0.1).
PRODUCT_DEBUG_PORT=8081
ORDER_DEBUG_PORT=8082

# --- Service URLs (as seen from inside the Compose network) ---
PRODUCT_SERVICE_URL=http://product-service:8081
ORDER_SERVICE_URL=http://order-service:8082

# --- HTTP client timeouts (Go duration format, e.g. 500ms, 2s) ---
# Order Service -> Product Service
ORDER_PRODUCT_CLIENT_CONNECT_TIMEOUT=2s
ORDER_PRODUCT_CLIENT_READ_TIMEOUT=3s
# BFF -> Product Service / Order Service (whole request)
BFF_PRODUCT_TIMEOUT=3s
BFF_ORDER_TIMEOUT=5s
